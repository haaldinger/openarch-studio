# OpenArch Studio — overridable settings. All have working defaults for local Compose.

# Published port for the Studio UI.
STUDIO_PORT=8900

# OpenAI-compatible model runtime. Defaults target the bundled Ollama service.
STUDIO_EMBEDDING_MODEL=nomic-embed-text
STUDIO_CHAT_MODEL=llama3.1

# Text extractor: docling (layout-aware, Tika fallback) or tika.
STUDIO_EXTRACTOR=docling

# To use a hosted OpenAI-compatible provider instead of Ollama, point the API at it:
#   STUDIO_MODEL_BASE_URL=https://api.your-provider.com/v1
#   (set the provider key in the studio-api service environment)

# Baseline mode: disable every Studio extension and show only native OpenArch OOTB features.
STUDIO_BASELINE_MODE=false
